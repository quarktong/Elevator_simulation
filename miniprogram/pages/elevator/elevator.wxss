page {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
  padding: 20rpx;
}

.container {
  padding: 20rpx;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 2rpx 2rpx 4rpx rgba(0,0,0,0.3);
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 10rpx;
}

.floor-selector-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.15);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.floor-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 15rpx;
}

.floor-btn {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
}

.floor-btn.selected {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  box-shadow: 0 6rpx 20rpx rgba(245, 87, 108, 0.4);
}

.floor-btn:hover {
  transform: scale(1.05);
}

.selected-info {
  background: #e8f5e9;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-top: 25rpx;
  text-align: center;
}

.selected-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 10rpx;
}

.selected-floor {
  font-size: 56rpx;
  font-weight: bold;
  color: #2e7d32;
}

.call-result {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.15);
}

.result-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.result-elevator {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.elevator-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-right: 20rpx;
}

.elevator-info {
  flex: 1;
}

.elevator-name-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.elevator-status-text {
  font-size: 24rpx;
  color: #888888;
}

.eta-display {
  text-align: right;
}

.eta-label {
  font-size: 22rpx;
  color: #888888;
}

.eta-time {
  font-size: 48rpx;
  font-weight: bold;
  color: #667eea;
}

.hint-text {
  text-align: center;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 30rpx;
}

.quick-calls {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.15);
}

.quick-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15rpx;
}

.quick-btn {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
}

.quick-btn.active {
  background: #667eea;
  color: #ffffff;
}