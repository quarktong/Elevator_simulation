page {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
  padding: 20rpx;
}

.container {
  padding: 20rpx;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 2rpx 2rpx 4rpx rgba(0,0,0,0.3);
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 10rpx;
}

.elevator-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.elevator-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.15);
}

.elevator-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.elevator-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.elevator-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-running {
  background: #e8f5e9;
  color: #2e7d32;
}

.status-idle {
  background: #fff3e0;
  color: #e65100;
}

.status-door-open {
  background: #e3f2fd;
  color: #1565c0;
}

.floor-display {
  text-align: center;
  margin: 20rpx 0;
}

.floor-number {
  font-size: 72rpx;
  font-weight: bold;
  color: #667eea;
}

.floor-label {
  font-size: 24rpx;
  color: #666666;
  margin-top: 10rpx;
}

.direction-row {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.direction-btn {
  padding: 15rpx 30rpx;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 26rpx;
  color: #666666;
}

.direction-btn.active {
  background: #667eea;
  border-color: #667eea;
  color: #ffffff;
}

.eta-section {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 15rpx;
}

.eta-title {
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 10rpx;
}

.eta-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #667eea;
}

.passenger-info {
  text-align: center;
  margin-top: 15rpx;
  font-size: 24rpx;
  color: #888888;
}

.system-info {
  background: rgba(255,255,255,0.9);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-around;
}

.info-item {
  text-align: center;
}

.info-label {
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 10rpx;
}

.info-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.status-normal {
  color: #2e7d32;
}

.status-warning {
  color: #e65100;
}